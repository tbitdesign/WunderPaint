{
	"name": "wpie-math-figures",
	"version": "0.4.0",
	"private": true,
	"type": "module",
	"description": "WPIE extension: Math Figures - formulas, function graphs, geometry, number lines, fractions",
	"scripts": {
		"build": "esbuild src/main.js --bundle --format=iife --minify --outfile=extension.js && esbuild src/mathjax-entry.js --bundle --format=iife --minify --outfile=assets/mathjax.js",
		"test": "node --test tests/*.test.js",
		"qa": "node tools/qa-dialog.mjs",
		"proof": "node tools/proof.mjs"
	},
	"dependencies": {
		"mathjax-full": "^3.2.2"
	},
	"devDependencies": {
		"esbuild": "^0.28.1"
	}
}
