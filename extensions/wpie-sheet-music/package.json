{
	"name": "wpie-sheet-music",
	"version": "0.4.3",
	"private": true,
	"type": "module",
	"description": "WPIE extension: Sheet Music - scores, leadsheets, chord diagrams and fretboard maps",
	"scripts": {
		"build": "esbuild src/main.js --bundle --format=iife --minify --outfile=extension.js",
		"test": "node --test tests/*.test.js",
		"qa": "node tools/qa-dialog.mjs",
		"proof": "node tools/proof.mjs"
	},
	"dependencies": {
		"abcjs": "^6.7.0"
	},
	"devDependencies": {
		"esbuild": "^0.28.1"
	}
}
