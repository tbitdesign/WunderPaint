{
	"name": "wpie-papercut-art",
	"version": "3.5.9",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "esbuild src/main.js --bundle --format=iife --minify --outfile=extension.js",
		"test": "node --test tests/*.test.js",
		"qa": "node tools/qa-dialog.mjs",
		"qa:library": "node tools/qa-library.mjs",
		"qa:thumbnails": "node tools/qa-thumbnails.mjs",
		"qa:panels": "node tools/qa-panels.mjs",
		"qa:photo-start": "node tools/qa-photo-start.mjs",
		"pack": "npm run build && mkdir -p dist && rm -f dist/papercut-art.zip && zip -r dist/papercut-art.zip manifest.json extension.js style.css"
	},
	"devDependencies": {
		"esbuild": "^0.24.0"
	}
}
