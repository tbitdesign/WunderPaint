#: src/screens/editor-menubar.jsx:1209
#: src/screens/mockup-dialog.jsx:325
#: src/screens/mockup-dialog.jsx:334
msgid "Mockup Generator"
msgstr "Mockup-Generator"

#: src/help/content.js:313
