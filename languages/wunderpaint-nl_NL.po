#: build-standalone/144.61981407.js:5
#: dist/public-export-preview/src/help/guides.js:44
#: dist/studio/app/js/144.c7ed9dcb.js:5
#: src/help/guides.js:44
#: build-standalone/144.61981407.js:6720
msgid "The Effects tab adds one-click looks, text effects like circles, markers and outlines, and warp. The STYLE presets in the text toolbar combine them with live previews."
msgstr "Het tabblad Effecten voegt looks met één klik toe, teksteffecten als cirkels, markeerstiften en contouren, en vervorming. De STYLE-voorinstellingen in de tekstwerkbalk combineren ze met live voorbeelden."

#: build-standalone/144.61981407.js:5
