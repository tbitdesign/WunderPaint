msgstr "Nieuwe pagina"

#: src/screens/pages-bar.jsx:124
#: src/screens/pages-bar.jsx:185
#: src/screens/pages-bar.jsx:186
msgid "Delete page"
msgstr "Pagina verwijderen"

#. translators: %d: page number.
#: src/screens/pages-bar.jsx:127
#, js-format
msgid "Delete page %d?"
msgstr "Pagina %d verwijderen?"

#. translators: 1: current page, 2: total pages.
#: src/screens/pages-bar.jsx:154
#, js-format
