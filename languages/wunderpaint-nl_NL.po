#: build-standalone/144.61981407.js:5
#: dist/public-export-preview/src/help/guides.js:34
#: dist/studio/app/js/144.c7ed9dcb.js:5
#: src/help/guides.js:34
#: build-standalone/144.61981407.js:6710
msgid "Font, size, spacing, alignment and text color live in Properties → Character; the toolbar above the canvas has the essentials too."
msgstr "Lettertype, grootte, afstand, uitlijning en tekstkleur staan in Eigenschappen → Teken; de werkbalk boven het canvas heeft het belangrijkste ook."

#: build-standalone/144.61981407.js:5
#: dist/public-export-preview/src/help/guides.js:43
#: dist/studio/app/js/144.c7ed9dcb.js:5
#: src/help/guides.js:43
#: build-standalone/144.61981407.js:6719
