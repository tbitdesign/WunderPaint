#, js-format
msgid "“%1$s”: font “%2$s” substituted."
msgstr "« %1$s » : la police « %2$s » a été substituée."

#. translators: %s: adjustment type.
#: src/lib/psd.js:566
#, js-format
msgid "Adjustment layer “%s” is not supported and was skipped."
msgstr "Le calque de réglage « %s » n'est pas pris en charge et a été ignoré."

#. translators: %s: layer name.
#: src/lib/psd.js:607
#, js-format
msgid "“%s” was rasterized from a vector layer."
msgstr "« %s » a été pixellisé depuis un calque vectoriel."

#. translators: %s: layer name.
#: src/lib/psd.js:622
#, js-format
msgid "“%s” had no drawable content and was skipped."
msgstr "« %s » n'avait aucun contenu affichable et a été ignoré."

#. translators: %s: layer name.
#: src/lib/psd.js:955
#, js-format
msgid "“%s”: gradient/pattern text fill became a solid color in the type layer (the pixel preview keeps the fill)."
msgstr "« %s » : le remplissage dégradé/motif du texte est devenu une couleur unie dans le calque de texte (l'aperçu en pixels conserve le remplissage)."

#. translators: %s: layer name.
#: src/lib/psd.js:985
#, js-format
msgid "Adjustment layer “%s” could not be written and was dropped from the layer stack (its effect is visible in the flattened composite)."
msgstr "Le calque de réglage « %s » n'a pas pu être écrit et a été retiré de la pile de calques (son effet est visible dans l'image aplatie)."

#. translators: %s: layer name.
#: src/lib/psd.js:1005
#, js-format
msgid "“%s”: filters/styles were baked into pixels."
msgstr "« %s » : les filtres/styles ont été fusionnés dans les pixels."

#: src/lib/qr.js:366
msgid "Low contrast between code and background, many scanners will fail."
msgstr "Faible contraste entre le code et le fond ; beaucoup de scanners échoueront."

#: src/lib/qr.js:373
msgid "Light code on a dark background: some scanners cannot read inverted QR codes."
msgstr "Code clair sur fond sombre : certains scanners ne lisent pas les codes QR inversés."

#: src/lib/qr.js:381
msgid "A light QR color needs a dark area behind the layer to stay scannable."
msgstr "Une couleur de QR claire nécessite une zone sombre derrière le calque pour rester scannable."

#: src/lib/qr.js:393
msgid "The logo covers a lot of the code. Keep it below about 25% and test the scan."
msgstr "Le logo couvre une grande partie du code. Reste sous environ 25 % et teste le scan."

#. translators: %d: number of documents.
#: src/lib/restore-offer.js:30
#, js-format
msgid "Your last session left unsaved changes and %d more open document(s)."
msgstr "Ta dernière session a laissé des modifications non enregistrées et %d document(s) ouvert(s) de plus."

#: src/lib/restore-offer.js:36
msgid "Restore session"
msgstr "Restaurer la session"

#. translators: %d: number of documents.
#: src/lib/restore-offer.js:43
#, js-format
msgid "Your last session had %d more open document(s)."
msgstr "Ta dernière session avait %d document(s) ouvert(s) de plus."

#: src/lib/restore-offer.js:49
msgid "Restore tabs"
msgstr "Restaurer les onglets"

#: src/lib/restore-offer.js:53
