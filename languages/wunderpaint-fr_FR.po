msgid "Request failed."
msgstr "Échec de la requête."

#: src/lib/api.js:72
msgid "Session expired, please reload the editor."
msgstr "Session expirée, recharge l'éditeur."

#: src/lib/api.js:81
#: src/lib/api.js:94
msgid "Could not refresh the session, please reload the editor."
msgstr "Impossible de renouveler la session, recharge l'éditeur."

#: src/lib/api.js:224
msgid "Could not load the stored project."
msgstr "Impossible de charger le projet enregistré."

#. translators: %d: HTTP status code.
#: src/lib/api.js:482
#, js-format
msgid "WordPress did not answer (HTTP %d). Reload the editor and try again."
msgstr "WordPress n'a pas répondu (HTTP %d). Recharge l'éditeur et réessaie."

#: src/lib/api.js:878
msgid "The web server aborted the AI request (timeout or size limit) before the provider finished. Please try again."
msgstr "Le serveur web a interrompu la requête IA (délai ou limite de taille) avant que le fournisseur ait terminé. Réessaie."

#: src/lib/api.js:930
msgid "The AI job is taking too long, please try again."
msgstr "La tâche IA prend trop de temps, réessaie."

#: src/lib/asset-insert.js:180
#: src/screens/create-dialog.jsx:184
#: src/screens/replace-dialog.jsx:109
