msgstr "Desenhar uma ponta de pincel"

#: src/screens/panels/brush-panel.jsx:376
#: src/screens/panels/properties-panel.jsx:1802
#: src/screens/shape-studio-core.jsx:470
msgid "Smoothing"
msgstr "Suavização"

#: src/screens/panels/brush-panel.jsx:394
msgid "Flow"
msgstr "Fluxo"

#: src/screens/panels/brush-panel.jsx:462
msgid "Tip shape"
msgstr "Forma da ponta"

#: src/screens/panels/brush-panel.jsx:467
msgid "Back to the tip's own values"
msgstr "Voltar aos valores da ponta"

#: src/screens/panels/brush-panel.jsx:611
msgid "A medium always paints into the layer, so this is off while one is picked."
msgstr "Um meio sempre pinta na camada, então esta opção fica desativada enquanto você tiver um escolhido."

#: src/screens/panels/brush-panel.jsx:631
msgid "Each stroke on its own layer"
msgstr "Cada traço em sua própria camada"

#. translators: %s: filter name.
#. translators: %s: filter name
#: src/screens/panels/effects-panel.jsx:187
#: src/store/ops/content-ops.js:49
#, js-format
msgid "Filter: %s"
msgstr "Filtro: %s"

#: src/screens/panels/effects-panel.jsx:214
msgid "Remove text effect"
msgstr "Remover efeito de texto"

#: src/screens/panels/effects-panel.jsx:223
msgid "Remove warp"
msgstr "Remover distorção"

#: src/screens/panels/effects-panel.jsx:245
msgid "Toggle smart filter"
msgstr "Alternar filtro inteligente"

#: src/screens/panels/effects-panel.jsx:257
msgid "Remove smart filter"
msgstr "Remover filtro inteligente"

#: src/screens/panels/effects-panel.jsx:268
msgid "Active on This Layer"
msgstr "Ativo nesta camada"

#: src/screens/panels/effects-panel.jsx:283
msgid "Open settings"
msgstr "Abrir configurações"

#: src/screens/panels/effects-panel.jsx:535
msgid "Applied as non-destructive Smart Filters."
msgstr "Aplicado como filtros inteligentes não destrutivos."

#: src/screens/panels/effects-panel.jsx:539
msgid "Applied destructively (vector layers rasterize first)."
msgstr "Aplicado de forma destrutiva (camadas vetoriais são rasterizadas antes)."

#: src/screens/panels/effects-panel.jsx:813
