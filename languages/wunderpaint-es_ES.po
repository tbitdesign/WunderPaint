msgstr "Velocidad de secado"

#: src/screens/panels/brush-panel.jsx:79
msgid "Edge darkening"
msgstr "Oscurecimiento del borde"

#: src/screens/panels/brush-panel.jsx:81
msgid "Wetness"
msgstr "Humedad"

#: src/screens/panels/brush-panel.jsx:83
msgid "Bleed"
msgstr "Sangrado"

#: src/screens/panels/brush-panel.jsx:85
msgid "Coverage"
msgstr "Cobertura"

#: src/screens/panels/brush-panel.jsx:87
msgid "Smearing"
msgstr "Emborronado"

#: src/screens/panels/brush-panel.jsx:89
msgid "Open time"
msgstr "Tiempo abierto"

#: src/screens/panels/brush-panel.jsx:91
msgid "Tooth"
msgstr "Dentado"

#: src/screens/panels/brush-panel.jsx:93
msgctxt "charcoal dial"
msgid "Pressure"
msgstr "Presión"

#: src/screens/panels/brush-panel.jsx:95
msgid "Pickup"
msgstr "Captación"

#. translators: %s: paint style name.
#: src/screens/panels/brush-panel.jsx:207
#, js-format
msgid "%s brushes"
msgstr "Pinceles de %s"

#: src/screens/panels/brush-panel.jsx:243
msgid "Saved tips"
msgstr "Puntas guardadas"

#: src/screens/panels/brush-panel.jsx:310
msgid "Draw a brush tip"
msgstr "Dibujar una punta de pincel"

#: src/screens/panels/brush-panel.jsx:376
#: src/screens/panels/properties-panel.jsx:1802
#: src/screens/shape-studio-core.jsx:470
msgid "Smoothing"
msgstr "Suavizado"

#: src/screens/panels/brush-panel.jsx:394
msgid "Flow"
msgstr "Flujo"

#: src/screens/panels/brush-panel.jsx:462
msgid "Tip shape"
msgstr "Forma de la punta"

#: src/screens/panels/brush-panel.jsx:467
msgid "Back to the tip's own values"
msgstr "Volver a los valores de la punta"

#: src/screens/panels/brush-panel.jsx:611
msgid "A medium always paints into the layer, so this is off while one is picked."
msgstr "Un medio siempre pinta en la capa, así que esta opción queda desactivada mientras tengas uno elegido."

#: src/screens/panels/brush-panel.jsx:631
msgid "Each stroke on its own layer"
msgstr "Cada trazo en su propia capa"

#. translators: %s: filter name.
