#: src/screens/editor-dialogs.jsx:117
#: build-standalone/144.ba1c6490.js:5426
#: build-standalone/144.ba1c6490.js:97406
msgid "Keyboard shortcuts"
msgstr "Atajos de teclado"

#: build-standalone/144.ba1c6490.js:5
#: build-standalone/144.ba1c6490.js:80
#: build-standalone/144.ba1c6490.js:155
