msgid "Some personal automation settings could not be restored."
msgstr "Non è stato possibile ripristinare alcune impostazioni personali di automazione."

#. translators: %d: number of extension packages that could not be restored.
#: includes/class-backup.php:576
#, php-format
msgid "%d extension could not be restored. Existing files for that package were retained."
msgid_plural "%d extensions could not be restored. Existing files for those packages were retained."
msgstr[0] "%d estensione non è stata ripristinata. I file esistenti di quel pacchetto sono stati conservati."
msgstr[1] "%d estensioni non sono state ripristinate. I file esistenti di quei pacchetti sono stati conservati."

#. translators: 1: templates, 2: designs, 3: version files, 4: extensions, 5: font files, 6: 3D model files, 7: studio presets.
#: includes/class-backup.php:584
#, php-format
msgid "Backup restored: %1$d template files, %2$d design files, %3$d version files, %4$d extensions, %5$d font files, %6$d 3D models, %7$d studio presets."
msgstr "Backup ripristinato: %1$d file di template, %2$d file di design, %3$d file di versione, %4$d estensioni, %5$d file di font, %6$d modelli 3D, %7$d preset degli studio."

#. translators: %d: number of users whose personal automation settings were restored.
#: includes/class-backup.php:596
#, php-format
msgid "Personal automation settings restored for %d user."
msgid_plural "Personal automation settings restored for %d users."
msgstr[0] "Impostazioni personali di automazione ripristinate per %d utente."
msgstr[1] "Impostazioni personali di automazione ripristinate per %d utenti."

#. translators: %d: number of users not present on this site.
#: includes/class-backup.php:603
#, php-format
msgid "Personal automation settings for %d unknown user were left out."
msgid_plural "Personal automation settings for %d unknown users were left out."
msgstr[0] "Le impostazioni personali di automazione di %d utente sconosciuto sono state escluse."
msgstr[1] "Le impostazioni personali di automazione di %d utenti sconosciuti sono state escluse."

#. translators: %d: number of studio presets.
#: includes/class-backup.php:610
#, php-format
msgid "%d studio preset was left out: its user does not exist here."
msgid_plural "%d studio presets were left out: their users do not exist here."
msgstr[0] "%d preset degli studio è stato tralasciato: il suo utente non esiste qui."
msgstr[1] "%d preset degli studio sono stati tralasciati: i loro utenti non esistono qui."

#: includes/class-backup.php:616
msgid "The version history was left out: this archive comes from a different site, and its versions belong to attachment IDs that mean something else here."
msgstr "La cronologia delle versioni è stata tralasciata: questo archivio proviene da un altro sito e le sue versioni appartengono a ID di allegati che qui significano altro."

#. translators: %s: directory
#: includes/class-backup.php:846
#, php-format
msgid "Could not create %s; the existing files were left untouched."
msgstr "Impossibile creare %s; i file esistenti sono rimasti intatti."

#. translators: 1: file name, 2: directory
#: includes/class-backup.php:859
#, php-format
msgid "Could not write %1$s; the existing files in %2$s were left untouched."
msgstr "Impossibile scrivere %1$s; i file esistenti in %2$s sono rimasti intatti."

#: includes/class-backup.php:907
#: includes/class-media-metadata.php:526
msgid "The previous version could not be stored, so the files were left untouched."
msgstr "La versione precedente non è stata conservata, quindi i file sono rimasti intatti."

#. translators: 1: file names, 2: directory
#: includes/class-backup.php:919
#: includes/class-backup.php:937
#, php-format
msgid "Could not put %1$s in place in %2$s; the files already there were kept and the library index was not changed."
msgstr "Impossibile mettere %1$s al suo posto in %2$s; i file già presenti sono stati conservati e l'indice della libreria non è stato modificato."

#. translators: %s: paths requiring manual recovery
#: includes/class-backup.php:974
#, php-format
msgid "The restore could not be rolled back completely. Check these recovery paths: %s"
msgstr "Non è stato possibile annullare completamente il ripristino. Controlla questi percorsi di recupero: %s"

