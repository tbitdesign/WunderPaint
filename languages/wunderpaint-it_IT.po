#: build-standalone/144.61981407.js:109802
msgid "Export Carousel"
msgstr "Esporta carosello"

#: build-standalone/144.61981407.js:5
#: build-standalone/144.61981407.js:11
#: build-standalone/144.61981407.js:80
#: build-standalone/144.61981407.js:90
#: build-standalone/144.61981407.js:142
