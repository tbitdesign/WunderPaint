#: src/screens/editor-menubar.jsx:1365
#: build-standalone/144.ba1c6490.js:6430
#: build-standalone/144.ba1c6490.js:100848
msgid "Manage Extensions"
msgstr "Gestisci estensioni"

#: build-standalone/144.ba1c6490.js:5
#: build-standalone/144.ba1c6490.js:80
#: build-standalone/144.ba1c6490.js:143
#: dist/public-export-preview/src/help/content.js:1177
#: dist/public-export-preview/src/screens/editor-menubar.jsx:1382
