#: src/help/content.js:680
#: build-standalone/144.61981407.js:6062
msgid "Fine-tune like any other document - or regenerate with a sharper brief."
msgstr "Rifinisci come qualsiasi altro documento - o rigenera con un brief più preciso."

#: build-standalone/144.61981407.js:5
#: dist/public-export-preview/src/help/content.js:653
#: dist/studio/app/js/144.c7ed9dcb.js:5
#: src/help/content.js:686
#: build-standalone/144.61981407.js:6068
