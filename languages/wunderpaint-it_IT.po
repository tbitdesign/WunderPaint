#. translators: 1: layer name, 2: font name.
#: src/lib/psd.js:538
#, js-format
msgid "“%1$s”: font “%2$s” substituted."
msgstr "«%1$s»: il font «%2$s» è stato sostituito."

#. translators: %s: adjustment type.
#: src/lib/psd.js:566
#, js-format
msgid "Adjustment layer “%s” is not supported and was skipped."
msgstr "Il livello di regolazione «%s» non è supportato ed è stato ignorato."

#. translators: %s: layer name.
#: src/lib/psd.js:607
#, js-format
msgid "“%s” was rasterized from a vector layer."
msgstr "«%s» è stato rasterizzato da un livello vettoriale."

#. translators: %s: layer name.
#: src/lib/psd.js:622
#, js-format
msgid "“%s” had no drawable content and was skipped."
msgstr "«%s» non aveva contenuto disegnabile ed è stato ignorato."

#. translators: %s: layer name.
#: src/lib/psd.js:955
#, js-format
msgid "“%s”: gradient/pattern text fill became a solid color in the type layer (the pixel preview keeps the fill)."
msgstr "«%s»: il riempimento sfumato/a motivo del testo è diventato tinta unita nel livello di testo (l'anteprima in pixel conserva il riempimento)."

#. translators: %s: layer name.
#: src/lib/psd.js:985
#, js-format
msgid "Adjustment layer “%s” could not be written and was dropped from the layer stack (its effect is visible in the flattened composite)."
msgstr "Il livello di regolazione «%s» non è stato scritto ed è stato rimosso dalla pila dei livelli (il suo effetto è visibile nell'immagine appiattita)."

#. translators: %s: layer name.
#: src/lib/psd.js:1005
#, js-format
msgid "“%s”: filters/styles were baked into pixels."
msgstr "«%s»: filtri/stili sono stati fusi nei pixel."

#: src/lib/qr.js:366
msgid "Low contrast between code and background, many scanners will fail."
msgstr "Poco contrasto tra codice e sfondo; molti scanner falliranno."

#: src/lib/qr.js:373
msgid "Light code on a dark background: some scanners cannot read inverted QR codes."
msgstr "Codice chiaro su sfondo scuro: alcuni scanner non leggono i codici QR invertiti."

#: src/lib/qr.js:381
msgid "A light QR color needs a dark area behind the layer to stay scannable."
msgstr "Un colore di QR chiaro richiede un'area scura dietro il livello per restare scansionabile."

#: src/lib/qr.js:393
msgid "The logo covers a lot of the code. Keep it below about 25% and test the scan."
msgstr "Il logo copre gran parte del codice. Tienilo sotto il 25% circa e prova la scansione."

#. translators: %d: number of documents.
#: src/lib/restore-offer.js:30
