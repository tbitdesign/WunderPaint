	"license": "GPL-2.0-or-later",
	"scripts": {
		"start": "wp-scripts start",
		"build:fonts": "node tools/build-fonts.js",
		"build": "node tools/sync-ort.js && node tools/build-content.js && node tools/build-ui-icons.js && node tools/build-license-texts.mjs && wp-scripts build && node tools/scrub-cdn.js",
		"lint:js": "wp-scripts lint-js",
		"lint:css": "wp-scripts lint-style",
		"test:unit": "wp-scripts test-unit-js",
		"test:ext": "bash tools/test-extensions.sh",
		"test:manifests": "node --test extensions/validate-manifests.test.mjs && node extensions/validate-manifests.mjs",
		"test:delivery": "php delivery/tests/run.php",
		"build:catalog": "node extensions/build-catalog.mjs",
		"publish:extensions": "bash extensions/publish.sh",
		"test:php": "bash tools/test-php.sh",
		"check:versions": "node tools/check-versions.mjs .",
		"check:db": "node tools/check-db-silence.mjs .",
		"check:werkbank": "node tools/check-no-werkbank.mjs .",
		"check": "node tools/run-checks.mjs",
		"check:alle": "node tools/run-checks.mjs --alle",
		"check:liste": "node tools/run-checks.mjs --liste",
		"makepot": "wp i18n make-pot . languages/wunderpaint.pot --domain=wunderpaint --exclude=build,build-standalone,dist,node_modules,tests,docs",
		"build:standalone": "webpack --config webpack.standalone.config.js --mode production"
	},
